# =========================================================================
# Maven Rules
# =========================================================================
# Ignore the entire build output directory
# Note the leading slash to target only the root target folder, protecting
# any actual packages named "target" inside your source code
/target/

# Maven release and backup files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.war
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/.maven-wrapper.log

# Avoid ignoring the Maven wrapper execution files if your project uses them
!/.mvn/wrapper/maven-wrapper.jar
!/.mvn/wrapper/maven-wrapper.properties

# =========================================================================
# IntelliJ IDEA Rules
# =========================================================================
# Covers user-specific setups, build artifacts, and crash logs
.idea/
*.iml
*.iws
*.ipr
out/

# In case you explicitly want to keep certain IntelliJ shared setups:
# !.idea/runConfigurations/
# !.idea/vcs.xml

# =========================================================================
# Java Rules
# =========================================================================
# Compiled class files
*.class

# Log files
*.log

# Crash logs
hs_err_pid*
replay_pid*

# Package Archives (Optional - usually redundant if built under /target/)
# Un-comment the lines below if you generate jars outside of Maven target
# *.jar
# *.war
# *.ear
# *.zip

# =========================================================================
# Operating System Files (Highly Recommended)
# =========================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# =========================================================================
# Eclipse IDE Rules
# =========================================================================
.classpath
.project
.settings/

# Optional: Additional Eclipse-specific build or factory paths
.factorypath

